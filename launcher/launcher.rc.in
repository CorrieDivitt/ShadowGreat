// launcher.rc.in - the launcher's name, version and manifest. CMake fills in
// the version from the project's VERSION file (build folder: launcher.rc).
// Originally: launcher.rc - the launcher's name, version and manifest, as Windows shows
// them in the file's Properties. (Programs with none of this look more
// suspicious to antivirus software.)
#include <winver.h>

1 24 "@SG_MANIFEST@"

1 VERSIONINFO
FILEVERSION     @SG_V1@,@SG_V2@,@SG_V3@,0
PRODUCTVERSION  @SG_V1@,@SG_V2@,@SG_V3@,0
FILEFLAGSMASK   0x3F
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Shadowgreat project"
            VALUE "FileDescription",  "Shadowgreat launcher: builds Shadowgate for Windows from your own ROM"
            VALUE "FileVersion",      "@SG_VERSION@"
            VALUE "InternalName",     "ShadowgreatLauncher"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Corrie and the Shadowgreat contributors. MIT License."
            VALUE "OriginalFilename", "ShadowgreatLauncher.exe"
            VALUE "ProductName",      "Shadowgreat"
            VALUE "ProductVersion",   "@SG_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
